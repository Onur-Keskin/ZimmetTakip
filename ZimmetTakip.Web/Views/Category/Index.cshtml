@model List<Category>
@{
    ViewData["Title"] = "Kategoriler";
}

<!-- Sayfa başlığı ve yeni kategori butonu -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Kategoriler</h1>
    <a asp-action="Create" class="btn btn-primary">Yeni Kategori</a>
</div>

<!-- Kategori listesi -->
<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Kategori Adı</th>
                    <th>Açıklama</th>
                    <th class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @* Hiç kategori yoksa bilgi satırı göster *@
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="3" class="text-center text-muted py-4">Henüz kategori eklenmemiş.</td>
                    </tr>
                }

                @* Her kategori için bir satır *@
                @foreach (var category in Model)
                {
                    <tr>
                        <td class="fw-semibold">@category.CategoryName</td>
                        <td>@category.Description</td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Edit" asp-route-id="@category.CategoryId" class="btn btn-sm btn-outline-primary">Düzenle</a>
                            <a asp-action="Delete" asp-route-id="@category.CategoryId" class="btn btn-sm btn-outline-danger">Sil</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
