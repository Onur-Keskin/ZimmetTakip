@model CategoryFormViewModel
@{
    ViewData["Title"] = "Yeni Kategori";
}

<h1 class="h3 mb-3">Yeni Kategori</h1>

<div class="card shadow-sm col-lg-6">
    <div class="card-body">
        <!-- Ekleme formu: form tag helper anti-forgery token'ı otomatik ekler -->
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <!-- Ortak form alanları -->
            <partial name="_CategoryForm" model="Model" />

            <button type="submit" class="btn btn-primary">Kaydet</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Vazgeç</a>
        </form>
    </div>
</div>

<!-- İstemci tarafı doğrulama script'leri -->
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
