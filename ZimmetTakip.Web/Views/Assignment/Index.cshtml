@model AssignmentListViewModel
@{
    ViewData["Title"] = "Zimmetler";
}

<!-- Sayfa başlığı ve yeni zimmet butonu -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Zimmetler</h1>
    <a asp-action="Create" class="btn btn-primary">Yeni Zimmet</a>
</div>

<!-- Sekme başlıkları: Bootstrap tab bileşeni (sayfa yenilenmeden sekme değişir).
     Sayılar AJAX iade sonrası JS tarafından güncellenir (id'ler bu yüzden var). -->
<ul class="nav nav-tabs" role="tablist">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#aktif-zimmetler" type="button" role="tab">
            Aktif Zimmetler <span id="activeCount" class="badge text-bg-primary">@Model.ActiveAssignments.Count</span>
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" data-bs-toggle="tab" data-bs-target="#zimmet-gecmisi" type="button" role="tab">
            Zimmet Geçmişi <span id="historyCount" class="badge text-bg-secondary">@Model.HistoryAssignments.Count</span>
        </button>
    </li>
</ul>

<div class="tab-content">
    <!-- 1. sekme: aktif zimmetler (returned_at boş) -->
    <div class="tab-pane fade show active" id="aktif-zimmetler" role="tabpanel">
        <div class="card shadow-sm border-top-0 rounded-top-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Varlık</th>
                            <th>Seri No</th>
                            <th>Kullanıcı</th>
                            <th>Zimmet Tarihi</th>
                            <th>Zimmet Notu</th>
                            <th class="text-end">İşlem</th>
                        </tr>
                    </thead>
                    <tbody id="activeTableBody">
                        @if (Model.ActiveAssignments.Count == 0)
                        {
                            <tr class="empty-row">
                                <td colspan="6" class="text-center text-muted py-4">Aktif zimmet bulunmuyor.</td>
                            </tr>
                        }

                        @foreach (var assignment in Model.ActiveAssignments)
                        {
                            <tr class="active-row" data-assignment-id="@assignment.AssignmentId">
                                <td class="fw-semibold">@assignment.Asset.AssetName</td>
                                <td><code>@assignment.Asset.SerialNo</code></td>
                                <td>@assignment.User.FullName</td>
                                <td>@assignment.AssignedAt.ToString("dd.MM.yyyy HH:mm")</td>
                                <td>@assignment.AssignmentNote</td>
                                <td class="text-end">
                                    @* JS kapalıysa bu link normal Return sayfasını açar;
                                       JS açıksa (assignment-index.js) tıklama yakalanır ve modal açılır. *@
                                    <a asp-action="Return" asp-route-id="@assignment.AssignmentId"
                                       class="btn btn-sm btn-outline-success js-return-button"
                                       data-assignment-id="@assignment.AssignmentId"
                                       data-asset-name="@assignment.Asset.AssetName"
                                       data-user-name="@assignment.User.FullName">İade Al</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- 2. sekme: zimmet geçmişi (returned_at dolu) -->
    <div class="tab-pane fade" id="zimmet-gecmisi" role="tabpanel">
        <div class="card shadow-sm border-top-0 rounded-top-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Varlık</th>
                            <th>Seri No</th>
                            <th>Kullanıcı</th>
                            <th>Zimmet Tarihi</th>
                            <th>İade Tarihi</th>
                            <th>Zimmet Notu</th>
                            <th>İade Notu</th>
                        </tr>
                    </thead>
                    <tbody id="historyTableBody">
                        @if (Model.HistoryAssignments.Count == 0)
                        {
                            <tr class="empty-row">
                                <td colspan="7" class="text-center text-muted py-4">Zimmet geçmişi bulunmuyor.</td>
                            </tr>
                        }

                        @foreach (var assignment in Model.HistoryAssignments)
                        {
                            <tr class="history-row">
                                <td class="fw-semibold">@assignment.Asset.AssetName</td>
                                <td><code>@assignment.Asset.SerialNo</code></td>
                                <td>@assignment.User.FullName</td>
                                <td>@assignment.AssignedAt.ToString("dd.MM.yyyy HH:mm")</td>
                                <td>@assignment.ReturnedAt?.ToString("dd.MM.yyyy HH:mm")</td>
                                <td>@assignment.AssignmentNote</td>
                                <td>@assignment.ReturnNote</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- İade modal penceresi: "İade Al" butonuyla açılır, iade notu alınır.
     Form tag helper anti-forgery token'ı gizli alan olarak ekler; JS formu serialize ederek token'ı da gönderir. -->
<div class="modal fade" id="returnModal" tabindex="-1" aria-labelledby="returnModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="returnForm" asp-action="ReturnAjax" method="post">
                <div class="modal-header">
                    <h1 class="modal-title fs-5" id="returnModalLabel">Zimmet İade</h1>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
                </div>
                <div class="modal-body">
                    <p>
                        <strong id="returnAssetName"></strong> varlığı
                        <strong id="returnUserName"></strong> kullanıcısından iade alınacak.
                    </p>

                    <!-- Hangi zimmetin iade edileceği (JS tarafından doldurulur) -->
                    <input type="hidden" id="returnAssignmentId" name="id" />

                    <label for="returnNote" class="form-label">İade Notu</label>
                    <textarea id="returnNote" name="returnNote" class="form-control" rows="3" maxlength="250"
                              placeholder="Örn. Sorunsuz teslim alındı"></textarea>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Vazgeç</button>
                    <button type="submit" id="returnSubmit" class="btn btn-success">İadeyi Onayla</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Sonuç bildirimi (Bootstrap toast): AJAX iade sonrası başarı / hata mesajı sağ altta görünür -->
<div class="toast-container position-fixed bottom-0 end-0 p-3">
    <div id="resultToast" class="toast align-items-center border-0" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div id="resultToastBody" class="toast-body"></div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Kapat"></button>
        </div>
    </div>
</div>

<!-- Sayfaya özel JS: modal ile AJAX iade, satırı geçmişe taşıma, toast bildirimi -->
@section Scripts {
    <script src="~/js/assignment-index.js" asp-append-version="true"></script>
}
