@model AssetFormViewModel
@{
    ViewData["Title"] = "Varlık Düzenle";
}

<h1 class="h3 mb-3">Varlık Düzenle</h1>

<div class="card shadow-sm col-xl-8">
    <div class="card-body">
        <!-- Düzenleme formu: hangi varlığın güncelleneceği gizli alanda taşınır -->
        <form asp-action="Edit" asp-route-id="@Model.AssetId" method="post">
            <input type="hidden" asp-for="AssetId" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <!-- Ortak form alanları -->
            <partial name="_AssetForm" model="Model" />

            <button type="submit" class="btn btn-primary">Kaydet</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Vazgeç</a>
        </form>
    </div>
</div>

<!-- İstemci tarafı doğrulama script'leri -->
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
