@model List<Asset>
@{
    ViewData["Title"] = "Varlıklar";
}

<!-- Sayfa başlığı ve yeni varlık butonu -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Varlıklar</h1>
    <a asp-action="Create" class="btn btn-primary">Yeni Varlık</a>
</div>

<!-- Canlı arama kutusu: yazdıkça (300 ms bekleyerek) AJAX ile tablo yenilenir -->
<div class="row mb-3">
    <div class="col-md-6">
        <input type="search" id="assetSearch" class="form-control"
               placeholder="Varlık adı, marka veya seri no ile ara..."
               autocomplete="off"
               data-search-url="@Url.Action("Search")" />
    </div>
    <div class="col-md-6 d-flex align-items-center">
        <small class="text-muted">Detayları görmek için satıra tıklayın.</small>
    </div>
</div>

<!-- Varlık listesi -->
<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Varlık Adı</th>
                    <th>Kategori</th>
                    <th>Marka / Model</th>
                    <th>Seri No</th>
                    <th>Durum</th>
                    <th>Alım Tarihi</th>
                    <th class="text-end">İşlemler</th>
                </tr>
            </thead>
            @* Düzenle/Sil adresleri data- özniteliklerinde: arama sonrası satırları çizen JS bu adresleri kullanır *@
            <tbody id="assetTableBody"
                   data-edit-url="@Url.Action("Edit")"
                   data-delete-url="@Url.Action("Delete")">
                @* Hiç varlık yoksa bilgi satırı göster *@
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">Henüz varlık eklenmemiş.</td>
                    </tr>
                }

                @* Her varlık için iki satır: görünen ana satır + tıklayınca açılan detay satırı.
                   JS (asset-index.js) arama sonrası aynı yapıyı tekrar oluşturur. *@
                @foreach (var asset in Model)
                {
                    <tr class="asset-row" data-status="@asset.Status">
                        <td class="fw-semibold">@asset.AssetName</td>
                        <td>@asset.Category.CategoryName</td>
                        <td>@asset.Brand @asset.Model</td>
                        <td><code>@asset.SerialNo</code></td>
                        <td>
                            <span class="badge @StatusHelper.GetBadgeClass(asset.Status)">@StatusHelper.GetDisplayName(asset.Status)</span>
                        </td>
                        <td>@asset.PurchaseDate?.ToString("dd.MM.yyyy")</td>
                        <td class="text-end text-nowrap">
                            <a asp-action="Edit" asp-route-id="@asset.AssetId" class="btn btn-sm btn-outline-primary">Düzenle</a>
                            <a asp-action="Delete" asp-route-id="@asset.AssetId" class="btn btn-sm btn-outline-danger">Sil</a>
                        </td>
                    </tr>
                    <tr class="asset-detail-row" style="display: none;">
                        <td colspan="7" class="p-0">
                            <div class="asset-detail-content bg-light px-4 py-3" style="display: none;">
                                <dl class="row mb-0 small">
                                    <dt class="col-sm-2">Kategori</dt>
                                    <dd class="col-sm-10">@asset.Category.CategoryName</dd>

                                    <dt class="col-sm-2">Alım Tarihi</dt>
                                    <dd class="col-sm-10">@(asset.PurchaseDate?.ToString("dd.MM.yyyy") ?? "-")</dd>

                                    <dt class="col-sm-2">Açıklama</dt>
                                    <dd class="col-sm-10 mb-0">@(asset.Description ?? "-")</dd>
                                </dl>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Sayfaya özel JS: canlı arama, detay satırı (slideToggle) ve arızalı satır vurgusu -->
@section Scripts {
    <script src="~/js/asset-index.js" asp-append-version="true"></script>
}
