@model List<User>
@{
    ViewData["Title"] = "Kullanıcılar";
}

<!-- Sayfa başlığı (kullanıcılar Kayıt Ol sayfasından eklenir, burada yeni kayıt butonu yok) -->
<h1 class="h3 mb-3">Kullanıcılar</h1>

<!-- Kullanıcı listesi -->
<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Ad Soyad</th>
                    <th>E-posta</th>
                    <th>Departman</th>
                    <th>Rol</th>
                    <th>Durum</th>
                    <th>Kayıt Tarihi</th>
                    <th class="text-end">İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @* Her kullanıcı için bir satır; pasif kullanıcılar soluk gösterilir *@
                @foreach (var user in Model)
                {
                    <tr class="@(user.IsActive ? "" : "text-muted")">
                        <td class="fw-semibold">@user.FullName</td>
                        <td>@user.Email</td>
                        <td>@user.Department</td>
                        <td>@RoleHelper.GetDisplayName(user.Role.RoleName)</td>
                        <td>
                            @if (user.IsActive)
                            {
                                <span class="badge text-bg-success">Aktif</span>
                            }
                            else
                            {
                                <span class="badge text-bg-secondary">Pasif</span>
                            }
                        </td>
                        <td>@user.CreatedAt.ToString("dd.MM.yyyy")</td>
                        <td class="text-end">
                            <a asp-action="Edit" asp-route-id="@user.UserId" class="btn btn-sm btn-outline-primary">Düzenle</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
