<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Zimmet Takip</title>

    <!-- Bootstrap 5 stil dosyası (wwwroot/lib altında yerel kopya) -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Uygulamaya özel ortak stiller -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ZimmetTakip.Web.styles.css" asp-append-version="true" />
</head>
<body class="bg-light">
    <!-- Üst menü (navbar): uygulama adı ve ana menü bağlantıları -->
    <header>
        <nav class="navbar navbar-expand-md navbar-dark bg-dark shadow-sm">
            <div class="container-fluid">
                <a class="navbar-brand fw-semibold" asp-controller="Home" asp-action="Index">Zimmet Takip</a>

                <!-- Küçük ekranlarda menüyü açıp kapatan buton -->
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#anaMenu"
                        aria-controls="anaMenu" aria-expanded="false" aria-label="Menüyü aç/kapat">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Menü bağlantıları: yeni sayfalar eklendikçe buraya eklenecek -->
                <div class="collapse navbar-collapse" id="anaMenu">
                    <ul class="navbar-nav me-auto">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">Ana Sayfa</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- İçerik alanı: her sayfanın kendi içeriği RenderBody ile buraya yerleşir -->
    <div class="container-fluid py-4">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <!-- Script dosyaları: önce jQuery, sonra Bootstrap 5 (Popper dahil bundle), en son site.js -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- Sayfaların kendi script'lerini eklemesi için isteğe bağlı bölüm -->
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
