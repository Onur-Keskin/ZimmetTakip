@* İşlem sonucu mesajları: controller'da TempData'ya yazılan mesajlar bir sonraki sayfada bir kez gösterilir.
   Layout'tan çağrıldığı için her sayfada ayrıca yazmaya gerek yoktur. *@

<!-- Başarılı işlem mesajı (yeşil) -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
    </div>
}

<!-- Hata / engellenen işlem mesajı (kırmızı) -->
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Kapat"></button>
    </div>
}
