@model ErrorViewModel
@{
    ViewData["Title"] = "Hata";
}

<!-- Beklenmeyen hata sayfası (geliştirme ortamı dışında gösterilir) -->
<div class="alert alert-danger shadow-sm col-lg-8">
    <h1 class="h4 alert-heading">Bir hata oluştu</h1>
    <p class="mb-2">İsteğiniz işlenirken beklenmeyen bir hata oluştu. Lütfen daha sonra tekrar deneyin.</p>

    @* Hata takibi için istek numarası (varsa) *@
    @if (Model.ShowRequestId)
    {
        <p class="mb-0 small">
            <strong>İstek No:</strong> <code>@Model.RequestId</code>
        </p>
    }
</div>

<a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Ana Sayfaya Dön</a>
